{
  "name": "custom-tour-creator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brikelley/custom-tour-creator.git"
  },
  "config": {
    "deployUrl": "https://<org>.bluestep.net/files/<id>/",
